# OpenList 服务地址（不要带结尾斜杠）
OPENLIST_URL=http://127.0.0.1:5244

# Docker Compose 内部服务地址：
# 如果用 docker compose 启动，本项目容器会自动使用 http://openlist:5244
# 本地 npm run dev 仍然使用上面的 http://127.0.0.1:5244

# OpenList 访问令牌（在 OpenList 后台「设置 -> 其他 -> 令牌」生成，或使用管理员 token）
# 留空则不带鉴权头，仅适用于无密码的本地实例
OPENLIST_TOKEN=

# 后端代理端口
PORT=3001
